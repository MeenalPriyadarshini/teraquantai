# Copy this file to .env. Never commit .env or share its secret values.
POSTGRES_DB=teraquantai
POSTGRES_USER=tq_user
POSTGRES_PASSWORD=change_me_locally
POSTGRES_PORT=5433

# Email delivery (optional for local development; required before production).
# For Gmail, use a Google App Password, not your normal account password.
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@terraquantai.local

# App URLs and local private-file storage.
FRONTEND_URL=http://localhost:4200
FILE_STORAGE_PATH=../.private-storage

# Optional first administrator bootstrap.
ADMIN_EMAIL=
ADMIN_PASSWORD=
