# Copy this file to .env. Never commit .env or share its secret values.
POSTGRES_DB=teraquantai
POSTGRES_USER=tq_user
POSTGRES_PASSWORD=change_me_locally
POSTGRES_PORT=5433

# Local email testing through Mailpit (Docker Compose).
MAIL_ENABLED=true
MAIL_PROVIDER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_AUTH=false
MAIL_STARTTLS=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@terraquantai.local

# Resend (switch MAIL_PROVIDER to resend when testing real email delivery).
# Keep the actual key only in your untracked local .env file or deployment secret store.
RESEND_API_KEY=
RESEND_BASE_URL=https://api.resend.com
# For Resend, set MAIL_FROM=TerraQuantAI <no-reply@notify.terraquantai.com>

FRONTEND_URL=http://localhost:4200
FILE_STORAGE_PATH=../.private-storage

# Optional first administrator bootstrap.
ADMIN_EMAIL=
ADMIN_PASSWORD=
